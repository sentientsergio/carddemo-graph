diff --git a/cobol/src/OriginTracker.java b/cobol/src/OriginTracker.java
new file mode 100644
index 0000000..36ebcbc
--- /dev/null
+++ b/cobol/src/OriginTracker.java
@@ -0,0 +1,33 @@
+import java.io.File;
+import java.io.PrintWriter;
+
+/* Provenance line-map instrumentation (carddemo-graph foundation patch).
+ * Emits, per preprocessing pass, a sidecar file `<temp>.origin` with one record
+ * per output line: "<outLine>\tPASS\t<inputLine>" for a passthrough line (origin =
+ * the input file of THIS pass at <inputLine>), or "<outLine>\tCOPY\t<copybookPath>\t<copyLine>"
+ * for a copybook-spliced line (a ROOT origin). Composing the per-pass sidecars
+ * (final output -> trace PASS links back through prior passes until a COPY/root)
+ * yields the (preprocessed-line -> original file+line) map the Normalize seam needs.
+ * Encapsulated in the MAPA adapter; offered upstream. */
+public final class OriginTracker {
+    private static PrintWriter sidecar = null;
+    private static int outLine = 0;
+
+    public static void begin(File tmp) {
+        if (sidecar != null) { sidecar.flush(); sidecar.close(); }   // close prior pass
+        try { sidecar = new PrintWriter(tmp.getPath() + ".origin"); }
+        catch (Exception e) { sidecar = null; }
+        outLine = 0;
+    }
+    public static void recordPass(int inputLine) {
+        outLine++;
+        if (sidecar != null) { sidecar.println(outLine + "\tPASS\t" + inputLine); sidecar.flush(); }
+    }
+    public static void recordCopy(String copybookPath, int copyLine) {
+        outLine++;
+        if (sidecar != null) { sidecar.println(outLine + "\tCOPY\t" + copybookPath + "\t" + copyLine); sidecar.flush(); }
+    }
+    public static void end() {
+        if (sidecar != null) { sidecar.flush(); sidecar.close(); sidecar = null; }
+    }
+}
